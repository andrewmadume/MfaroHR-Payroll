DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mfaro
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BETTER_AUTH_URL=http://localhost:3000
APP_MODE=demo
LOCAL_DEMO_PASSWORD=CHOOSE_A_STRONG_LOCAL_PASSWORD
DOCUMENT_DIRECTORY=.local/documents
DOCUMENT_STORAGE=local
# For Vercel use DOCUMENT_STORAGE=vercel-blob and connect a PRIVATE Blob store.
# Keep this token server-only; never prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Optional direct PostgreSQL URL for migrations; DATABASE_URL is the pooled runtime URL.
DIRECT_URL=
